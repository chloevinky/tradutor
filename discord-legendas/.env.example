# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Deepgram API key (console.deepgram.com). Sem ela o bot conecta e diagnostica
# o DAVE, mas não gera legendas.
DEEPGRAM_API_KEY=

# Modelo/idioma do Deepgram (nova-3 tem suporte a pt-BR em streaming;
# use nova-2 como alternativa)
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=pt-BR

# Opcional: IDs dos servidores (separados por vírgula) para registrar os
# comandos /join /leave /dave instantaneamente. Sem isso o registro global
# pode levar até 1 hora.
GUILD_IDS=
